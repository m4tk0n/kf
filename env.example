# env.example (zkopirovat jako .env; soubor musi byt chraneny pred pristupem z webu)

APP_ENV=production
BASE_URL=https://7x.wz.cz/_kf/
# APP_KEY se pouziva pro HMAC (CSRF, OAuth state) - nikdy nemenit v provozu, jinak prestanou platit podpisy
APP_KEY=zmen-tento-dlouhy-nahodny-klic-minimalne-32-znaku
# AI_WRITE_KEY: stejnou hodnotu ulozit i do GitHub Secrets (AI_WRITE_KEY) pro workflow AI importu
AI_WRITE_KEY=zmen-tento-tajny-ai-write-klic

# INSTALL_KEY: klic pro install/index.php (zadava se pri kazdem spusteni, instalator MAZE tabulky i data)
# Prazdny INSTALL_KEY = instalator je vypnuty
INSTALL_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=vase_databaze
DB_USER=vase_uzivatelske_jmeno
DB_PASS=vase_heslo
TABLE_PREFIX=kf_

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://7x.wz.cz/_kf/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://7x.wz.cz/_kf/auth/facebook/callback

MAIL_TRANSPORT=mail
MAIL_FROM=noreply@7x.wz.cz
MAIL_FROM_NAME="K&F"

# Rezerva pro pozdejsi prechod na SMTP (pri MAIL_TRANSPORT=mail se nepouziva)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
