# .htaccess
Options -Indexes
DirectoryIndex index.php index.html

# Dočasně zakázat indexaci a ukládání obsahu do mezipaměti.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</IfModule>

# tajné soubory
<FilesMatch "^(\.env|env\.example|config\.php|bootstrap\.php)$">
  Require all denied
</FilesMatch>

# pretty URL: vše, co není soubor ani složka, jde do index.php (auth/google/login, profile, admin/users ...)
RewriteEngine On

# /debug/ je zároveň adresář statických souborů; tuto adresu vždy předat routeru.
RewriteRule ^debug/?$ index.php [L]
RewriteRule ^(src|templates|lang|data|cron)(/|$) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
